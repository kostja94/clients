  "forbidden_regex_zh": [
    {
      "pattern": "(?<![预保])留人",
      "hint": "GTM 黑话「留人」；若指 retention 用「留存」，若属「预留」则改写句子避免误读"
    },
    {
      "pattern": "同属[^\\n]{0,24}同族",
      "hint": "改用「同一类 freemium 玩法」或「和 … 是一路子，但 KPI 分开算」"
    },
    {
      "pattern": "和[^\\n]{0,12}badge[^\\n]{0,20}同族",
      "hint": "改用「和页脚 badge 是同一类 freemium 交换」"
    },
    {
      "pattern": "(?i)\\bexport\\s+水印",
      "hint": "改用「导出物水印」或「导出带标」"
    },
    {
      "pattern": "(?i)export\\s+增长",
      "hint": "改用「导出带标增长」"
    },
    {
      "pattern": "可见\\s*gate",
      "hint": "改用「可见水印门槛」"
    },
    {
      "pattern": "(?i)watermark\\s+增长",
      "hint": "改用「水印增长」"
    },
    {
      "pattern": "(?i)playbook\\s+弱",
      "hint": "改用「打法偏弱」"
    },
    {
      "pattern": "(?i)pay-to-remove",
      "hint": "改用「付费去水印」或「付费去标」"
    },
    {
      "pattern": "(?i)freemium\\s+gate",
      "hint": "改用「免费增值门槛」"
    },
    {
      "pattern": "(?i)growth\\s+gate",
      "hint": "改用「增长门槛」"
    },
    {
      "pattern": "(?i)self-serve",
      "hint": "改用「自助」"
    },
    {
      "pattern": "(?i)customer-facing",
      "hint": "改用「面向客户」"
    }
  ],
  "forbidden_regex_en": [
    {
      "pattern": "shares the embedded virality \\*\\*family\\*\\*",
      "hint": "Use «same freemium pattern as embedded virality» or «related playbook»"
    }
  ]
